# Local Docker Compose configuration
NODE_ENV=development
APP_PORT=3000
POSTGRES_DB=motivation_calendar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Puerto host para Postgres (docker-compose.yml: "${POSTGRES_PORT:-5432}:5432").
# Si el 5432 está ocupado, pon p.ej. POSTGRES_PORT=5433 en tu .env.
POSTGRES_PORT=5432
JWT_SECRET=local-development-jwt-secret-change-me
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
