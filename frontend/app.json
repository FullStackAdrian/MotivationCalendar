{
  "expo": {
    "name": "Motivation Calendar",
    "slug": "motivation-calendar",
    "version": "1.1.4",
    "orientation": "portrait",
    "scheme": "motivationcalendar",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.fullstackadrian.motivationcalendar",
      "versionCode": 2
    },
    "ios": {
      "bundleIdentifier": "com.fullstackadrian.motivationcalendar"
    }
  }
}
