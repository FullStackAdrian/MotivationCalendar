# Puerto del servidor
PORT=3000

# Secreto para JWT (cambiar en producción - OBLIGATORIO)
JWT_SECRET=tu-secreto-super-seguro-cambia-en-produccion

# Entorno (development, production)
NODE_ENV=development

# ==========================================
# Configuración de PostgreSQL
# ==========================================
# Opción 1: URL completa de conexión
DATABASE_URL=postgres://usuario:password@localhost:5432/motivation_calendar

# Opción 2: Variables individuales (se usa si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=motivation_calendar
DB_USER=postgres
DB_PASSWORD=postgres

# Puerto host para Postgres en docker-compose.yml (cámbialo si el 5432 está ocupado,
# p.ej. POSTGRES_PORT=5433, y ajusta DATABASE_URL/DB_PORT en consecuencia)
POSTGRES_PORT=5432

# Orígenes permitidos para CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Anti fuerza-bruta en /api/auth (BETA-1): intentos por IP cada 15 min (defecto 10)
AUTH_RATE_LIMIT_MAX=10

# Proxies de confianza delante del backend, p. ej. nginx en compose (defecto 1)
TRUST_PROXY_HOPS=1
