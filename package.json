{
  "name": "motivation-calendar",
  "version": "1.0.0",
  "description": "Aplicación de seguimiento de hábitos con autenticación JWT y sincronización multi-dispositivo",
  "main": "backend/dist/server.js",
  "scripts": {
    "start": "node backend/dist/server.js",
    "dev": "tsx watch backend/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test --test-concurrency=1 test/*.test.ts test/integration/*.test.ts",
    "test:integration": "node --import=tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:coverage": "mkdir -p coverage && npx c8 --include 'backend/**/*.ts' --lines 80 --functions 80 --reporter text --reporter text-summary node --import=tsx --test --test-concurrency=1 test/*.test.ts test/integration/*.test.ts > coverage/test-coverage.txt 2>&1; exit $?",
    "lint": "npm run typecheck && node scripts/check-js-syntax.js",
    "test:frontend": "node scripts/frontend-smoke.js",
    "test:watch": "node --import=tsx --test --watch",
    "install:all": "npm install"
  },
  "keywords": [
    "tracker",
    "habits",
    "calendar",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
