{
  "include": ["backend/**/*.ts"],
  "exclude": [
    "test/**",
    "**/*.d.ts",
    "backend/dist/**",
    "backend/application/ports/**",
    "backend/domain/types.ts",
    "backend/domain/repositories/**",
    "backend/infrastructure/types/**"
  ],
  "reporter": ["text", "text-summary", "lcov"],
  "reportsDir": "./coverage",
  "all": true,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "branches": 75,
  "perFile": true
}
