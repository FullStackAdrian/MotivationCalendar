{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "backend",
    "outDir": "backend/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules", "backend/dist"]
}
